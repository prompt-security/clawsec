        "declaration": {
          "$ref": "#/definitions/transformationDeclaration"
        },
        "before": {
          "$ref": "#/definitions/fileState"
        },
        "after": {
          "$ref": "#/definitions/fileState"
        },
        "rollback_source": {
          "$ref": "#/definitions/capturedFileRollbackSource"
        }
      }
